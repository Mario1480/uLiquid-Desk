FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json ./
COPY scripts/check_install_environment.js ./scripts/check_install_environment.js
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/runner/package.json apps/runner/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/exchange/package.json packages/exchange/package.json
COPY packages/futures-core/package.json packages/futures-core/package.json
COPY packages/futures-engine/package.json packages/futures-engine/package.json
COPY packages/futures-exchange/package.json packages/futures-exchange/package.json
COPY packages/orchestrator/package.json packages/orchestrator/package.json
COPY packages/risk/package.json packages/risk/package.json
COPY packages/strategies/package.json packages/strategies/package.json
RUN ok=0; \
  for i in 1 2 3 4 5; do \
    npm ci --include=dev --workspaces --include-workspace-root --legacy-peer-deps && { ok=1; break; } || { \
      echo "npm ci failed (${i}/5), trying npm install fallback..."; \
      npm install --workspaces --include-workspace-root --include=optional --legacy-peer-deps --no-audit --prefer-offline && { ok=1; break; } || { \
        echo "npm install fallback failed (${i}/5), retrying..."; \
        sleep 3; \
      }; \
    }; \
  done; \
  [ "$ok" -eq 1 ]

FROM deps AS build
ARG NEXT_PUBLIC_API_URL=https://api.desk.uliquid.vip
ARG NEXT_PUBLIC_AUTH_COOKIE_PREFIX=mm
ARG NEXT_PUBLIC_WEB3_TARGET_CHAIN_ID=999
ARG NEXT_PUBLIC_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
ARG NEXT_PUBLIC_HYPEREVM_EXPLORER_URL=https://hyperevmscan.io
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_WEB3_ENABLE_ARBITRUM=1
ARG NEXT_PUBLIC_APP_RELEASE_TAG
ARG NEXT_PUBLIC_ULIQ_ENABLED=false
ARG NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_ENABLED=true
ARG NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_LIVE_DATA_ENABLED=false
ARG NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_CHAIN_ID=42161
ARG NEXT_PUBLIC_ULIQ_ADMIN_VISIBLE=true
ARG NEXT_PUBLIC_ULIQ_CHAIN_ID=421614
ARG NEXT_PUBLIC_ULIQ_EXPLORER_URL=https://sepolia.arbiscan.io
ARG NEXT_PUBLIC_ULIQ_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_COOKIE_PREFIX=${NEXT_PUBLIC_AUTH_COOKIE_PREFIX}
ENV API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WEB3_TARGET_CHAIN_ID=${NEXT_PUBLIC_WEB3_TARGET_CHAIN_ID}
ENV NEXT_PUBLIC_HYPEREVM_RPC_URL=${NEXT_PUBLIC_HYPEREVM_RPC_URL}
ENV NEXT_PUBLIC_HYPEREVM_EXPLORER_URL=${NEXT_PUBLIC_HYPEREVM_EXPLORER_URL}
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=${NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID}
ENV NEXT_PUBLIC_WEB3_ENABLE_ARBITRUM=${NEXT_PUBLIC_WEB3_ENABLE_ARBITRUM}
ENV NEXT_PUBLIC_APP_RELEASE_TAG=${NEXT_PUBLIC_APP_RELEASE_TAG}
ENV NEXT_PUBLIC_ULIQ_ENABLED=${NEXT_PUBLIC_ULIQ_ENABLED}
ENV NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_ENABLED=${NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_ENABLED}
ENV NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_LIVE_DATA_ENABLED=${NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_LIVE_DATA_ENABLED}
ENV NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_CHAIN_ID=${NEXT_PUBLIC_ULIQ_PUBLIC_PRESALE_CHAIN_ID}
ENV NEXT_PUBLIC_ULIQ_ADMIN_VISIBLE=${NEXT_PUBLIC_ULIQ_ADMIN_VISIBLE}
ENV NEXT_PUBLIC_ULIQ_CHAIN_ID=${NEXT_PUBLIC_ULIQ_CHAIN_ID}
ENV NEXT_PUBLIC_ULIQ_EXPLORER_URL=${NEXT_PUBLIC_ULIQ_EXPLORER_URL}
ENV NEXT_PUBLIC_ULIQ_RPC_URL=${NEXT_PUBLIC_ULIQ_RPC_URL}
COPY . .
RUN npm -w packages/core run build \
  && npm -w packages/futures-core run build \
  && npm -w apps/web run build

FROM node:20-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/packages/core /app/packages/core
COPY --from=build /app/packages/futures-core /app/packages/futures-core
COPY --from=build /app/apps/web/.next /app/apps/web/.next
COPY --from=build /app/apps/web/public /app/apps/web/public
COPY --from=build /app/apps/web/app /app/apps/web/app
COPY --from=build /app/apps/web/components /app/apps/web/components
COPY --from=build /app/apps/web/lib /app/apps/web/lib
COPY --from=build /app/apps/web/next.config.mjs /app/apps/web/next.config.mjs
COPY --from=build /app/apps/web/package.json /app/apps/web/package.json
WORKDIR /app/apps/web
CMD ["npm", "run", "start"]
