{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node ../../scripts/clean_next_artifacts.mjs --build && node ../../scripts/with_root_env.mjs next build",
    "start": "next start -p 3000",
    "typecheck": "node ../../scripts/clean_next_artifacts.mjs && node ../../scripts/with_root_env.mjs next typegen && tsc --noEmit --incremental false -p tsconfig.json",
    "test:prefill": "tsx --test src/schemas/tradeDeskPrefill.test.ts",
    "test:predictions-ui": "tsx --test src/predictions/refreshUi.test.ts",
    "test:bots-ui": "tsx --test src/bots/controls.test.ts",
    "test:api-base": "tsx --test src/api/base.test.ts",
    "test:grid-catalog": "tsx --test src/grid/catalog.test.ts",
    "test:billing": "tsx --test src/billing/*.test.ts",
    "test:i18n-routing": "tsx --test src/i18n/localeRouting.test.ts",
    "test:agent-chat-ui": "tsx --test src/agent-chat/*.test.ts",
    "test:uliq-admin": "tsx --test src/uliq/*.test.ts",
    "i18n:check": "tsx src/i18n/integrity.ts",
    "test:einui": "tsx --test src/einui/*.test.tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
