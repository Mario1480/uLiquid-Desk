    "@reown/appkit": "1.8.19",
    "@reown/appkit-adapter-wagmi": "1.8.19",
    "@tanstack/react-query": "^5.90.21",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.12",
    "next-intl": "^4.11.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "viem": "2.55.10",
    "wagmi": "3.5.0",
    "zod": "^3.23.8",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-popover": "1.1.23",
