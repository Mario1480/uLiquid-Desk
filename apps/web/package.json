    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.2.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/node": "25.0.6",
    "@types/react": "19.2.8",
    "tsx": "^4.19.2",
