{
  "name": "@mm/contracts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "forge build",
    "typecheck": "forge build",
    "test": "forge test -vv",
    "fmt": "forge fmt",
    "deploy:local": "npm run deploy:botvaultv4:local",
    "deploy:devnet": "npm run deploy:botvaultv4:devnet",
    "deploy:botvaultv4:local": "forge script script/DeployBotVaultV4.s.sol:DeployBotVaultV4 --sig \"runLocal(address)\" ${DEPLOY_OWNER:-0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266} --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --private-key ${PRIVATE_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80} --chain-id ${CHAIN_ID:-31337} ${FORGE_BROADCAST_ARGS:-} --broadcast",
    "deploy:botvaultv4:devnet": "forge script script/DeployBotVaultV4.s.sol:DeployBotVaultV4 --sig \"runDevnet(address,address)\" ${DEPLOY_OWNER:-0x0000000000000000000000000000000000000000} ${USDC_ADDRESS} --rpc-url ${RPC_URL} --private-key ${PRIVATE_KEY} --chain-id ${CHAIN_ID:-999} ${FORGE_BROADCAST_ARGS:-} --broadcast",
    "deploy:fundingvaultv1:dry-run": "forge script script/DeployFundingVaultFactoryV1.s.sol:DeployFundingVaultFactoryV1 --sig \"runProd(address,address)\" ${USDC_ADDRESS} ${BOT_VAULT_FACTORY_V4_ADDRESS} --rpc-url ${RPC_URL} --private-key ${PRIVATE_KEY} --chain-id ${CHAIN_ID:-999} ${FORGE_BROADCAST_ARGS:-}",
    "deploy:fundingvaultv1:prod": "forge script script/DeployFundingVaultFactoryV1.s.sol:DeployFundingVaultFactoryV1 --sig \"runProd(address,address)\" ${USDC_ADDRESS} ${BOT_VAULT_FACTORY_V4_ADDRESS} --rpc-url ${RPC_URL} --private-key ${PRIVATE_KEY} --chain-id ${CHAIN_ID:-999} ${FORGE_BROADCAST_ARGS:-} --broadcast",
    "test:uliq": "forge test --match-path 'test/uliq/*.sol' -vv",
    "deploy:uliq:testnet:dry-run": "forge script script/uliq/DeployULIQTestnet.s.sol:DeployULIQTestnet --sig \"run(address,address,address,uint64,uint64,uint64)\" ${ULIQ_ADMIN_ADDRESS} ${ULIQ_TREASURY_ADDRESS} ${ULIQ_TEST_USDC_ADDRESS} ${ULIQ_SALE_START} ${ULIQ_SALE_END} ${ULIQ_WITHDRAWAL_PERIOD_SECONDS} --rpc-url ${ARBITRUM_SEPOLIA_RPC_URL} --private-key ${ULIQ_TESTNET_DEPLOYER_PRIVATE_KEY} --chain-id 421614 ${FORGE_BROADCAST_ARGS:-}",
    "deploy:uliq:testnet": "npm run deploy:uliq:testnet:dry-run -- --broadcast",
    "configure:uliq:testnet:dry-run": "forge script script/uliq/ConfigureULIQTestnet.s.sol:ConfigureULIQTestnet --sig \"run(address,address,address,address)\" ${ULIQ_TOKEN_ADDRESS} ${ULIQ_PRESALE_ADDRESS} ${ULIQ_VESTING_ADDRESS} ${ULIQ_PAYMENT_CUSTODY_ADDRESS} --rpc-url ${ARBITRUM_SEPOLIA_RPC_URL} --private-key ${ULIQ_TESTNET_DEPLOYER_PRIVATE_KEY} --chain-id 421614 ${FORGE_BROADCAST_ARGS:-}",
    "configure:uliq:testnet": "npm run configure:uliq:testnet:dry-run -- --broadcast"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0"
  }
}
